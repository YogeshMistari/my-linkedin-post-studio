# -------------------------------------------------
# TEXT GENERATION
# -------------------------------------------------
# Free/local default
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional OpenAI text fallback
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# -------------------------------------------------
# IMAGE GENERATION
# -------------------------------------------------
# Leave blank for the free V1 and use "Upload mine".
# Set to openai only if you have OpenAI API credits.
IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=

# -------------------------------------------------
# SOCIAL PUBLISHING - added in a later milestone
# -------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# -------------------------------------------------
# TEXT GENERATION
# -------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional OpenAI text fallback
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# -------------------------------------------------
# IMAGE GENERATION
# -------------------------------------------------
# Free/local default
IMAGE_PROVIDER=drawthings
DRAWTHINGS_BIN=draw-things-cli
DRAWTHINGS_MODEL=flux_2_klein_4b_q8p.ckpt
DRAWTHINGS_STEPS=4
# Optional override if Draw Things models live elsewhere:
# DRAWTHINGS_MODELS_DIR=/Users/yourname/Library/Containers/com.liuliu.draw-things/Data/Documents/Models

# Optional OpenAI image fallback
OPENAI_IMAGE_MODEL=

# -------------------------------------------------
# SOCIAL PUBLISHING - added in a later milestone
# -------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
